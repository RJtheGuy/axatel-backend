# Copy this file to .env and fill in your values.
# .env is NEVER committed to git — add it to .gitignore

# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-string-min-50-chars
SITE_URL=https://axatel.it
SITE_DOMAIN=axatel.it

# Database
# PostgreSQL (default):
DB_NAME=axatel
DB_USER=axatel
DB_PASSWORD=Axatel012026
DB_HOST=localhost
DB_PORT=5432

# MySQL / MariaDB — change ENGINE in settings/base.py, then use these:
# DB_NAME=axatel
# DB_USER=axatel
# DB_PASSWORD=Axatel012026
# DB_HOST=192.168.1.50    ← your in-house server IP
# DB_PORT=3306

# MSSQL — change ENGINE to mssql in settings/base.py, then:
# DB_NAME=axatel
# DB_USER=axatel
# DB_PASSWORD=Axatel012026
# DB_HOST=192.168.1.50\SQLEXPRESS
# DB_PORT=1433

# Redis (optional in dev — uses in-memory cache if not set)
REDIS_URL=redis://127.0.0.1:6379/1

# Email (Sendgrid example)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_api_key
