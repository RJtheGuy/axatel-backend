# Copy this to .env and fill in real values.
# .env is NEVER committed to git — add it to .gitignore

# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-string-min-50-chars
SITE_URL=https://axatel.it
SITE_DOMAIN=axatel.it

# Database — DB_HOST must match the docker-compose service name
DB_NAME=axatel_db
DB_USER=axatel_admin
DB_PASSWORD=change_me
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/1

# Email (Sendgrid example)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_api_key
